  "AboutUs.SECTIONS": [
    {
      "id": "story",
      "direction": "image-right",
      "eyebrow": "About Sleep n Dream",
      "heading": "The Legacy of\nLuxurious Sleep",
      "body": [
        "Founded in 1998, Sleep n Dream was born with a single commitment: to redefine the art of rest through precision craftsmanship, ergonomic excellence, and relentless innovation.",
        "We believe that a great day begins with a restful night, and for over two decades, we have been dedicated to elevating your quality of life through ultimate sleep comfort."
      ],
      "stat": {
        "number": "1998",
        "label": "Est. Jakarta, Indonesia"
      },
      "image": "/banner/banner-one.jpg",
      "imageAlt": "Sleep n Dream craftsmanship and sleep heritage"
    },
    {
      "id": "innovation",
      "direction": "image-left",
      "eyebrow": "Our Innovation",
      "heading": "Pioneering Since Day One.",
      "body": [
        "From the very beginning, Sleep n Dream has been a true pioneer in the mattress industry — the first to introduce the revolutionary 5-Zone Firmness system, meticulously engineered to deliver targeted ergonomic support where your body needs it most.",
        "Continuing our legacy of firsts: Dr. Spine, the first dedicated orthopedic mattress for optimal spinal health; the first high-density firm latex mattress for back support; and the first brand to introduce integrated zipper covers for effortless care."
      ],
      "stat": {
        "number": "28+",
        "label": "Years of pioneering"
      },
      "image": "/banner/banner-two.jpg",
      "imageAlt": "Sleep n Dream innovation and mattress craftsmanship"
    }
  ],
